#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

RECON_DB_EXPLORER_DIR="/root/payloads/user/remote_access/recon_db_explorer"
WEB_DIR="$RECON_DB_EXPLORER_DIR/www"
PORT=8889
PID_FILE="/tmp/recon_db_explorer.pid"
LOG_FILE="/tmp/recon_db_explorer.log"

# Permanent logging function for troubleshooting
log_init() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [init] $*" >> "$LOG_FILE"
}

start_service() {
    log_init "start_service called"
    log_init "RECON_DB_EXPLORER_DIR=$RECON_DB_EXPLORER_DIR"
    log_init "WEB_DIR=$WEB_DIR"

    if [ ! -d "$WEB_DIR" ]; then
        log_init "ERROR: WEB_DIR does not exist: $WEB_DIR"
        return 1
    fi

    log_init "WEB_DIR exists, setting permissions"
    chmod -R 755 "$WEB_DIR" 2>/dev/null

    log_init "Starting uhttpd via procd"

    procd_open_instance recon_db_explorer_http
    procd_set_param command /usr/sbin/uhttpd -f -p "$PORT" -h "$WEB_DIR" -c /cgi-bin -T 60
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile "$PID_FILE"
    procd_close_instance

    log_init "procd instance configured"
}

stop_service() {
    log_init "stop_service called"
    rm -f /tmp/recon_db_explorer_auth_session
    rm -f "$PID_FILE"
    log_init "Cleanup complete"
}
